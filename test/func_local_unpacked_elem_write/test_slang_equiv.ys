# read_uhdm vs read_slang: the only real gate here.  read_verilog cannot parse
# declarations inside a function's begin block, so the verilog comparison is
# vacuous for this DUT.
read_uhdm slpp_all/surelog.uhdm
hierarchy -top dut
flatten; proc; opt; memory; async2sync
rename dut gold; design -stash gold
read_slang dut.sv
hierarchy -top dut
flatten; proc; opt; memory; async2sync
rename dut gate; design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -set-init-zero miter

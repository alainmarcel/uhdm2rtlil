# read_verilog cannot flatten an interface port the way read_uhdm and read_slang
# do, so the ordinary verilog-vs-uhdm comparison says nothing here; the miter
# against read_slang is the real gate.  With the port members sized from the
# interface DECLARATION (W = 0 -> `[-1:0]`, two bits) the upper two bits of
# every path through the child are dropped and this miter finds it immediately.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top dut
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename dut gold
design -stash gold
read_slang dut.sv --top dut
hierarchy -check -top dut
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename dut gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter

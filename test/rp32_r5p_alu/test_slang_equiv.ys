# UHDM-vs-slang miter for rp32_r5p_alu (read_verilog cannot parse the rp32
# packages' cast syntax, so read_slang is the reference).
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top r5p_alu_dec_wrap
flatten; proc; opt; techmap; opt
rename r5p_alu_dec_wrap gold
design -stash gold

read_slang -f project.f wrap.sv --top r5p_alu_dec_wrap
hierarchy -check -top r5p_alu_dec_wrap
flatten; proc; opt; techmap; opt
rename r5p_alu_dec_wrap gate
design -stash gate

design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter

read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top func_inline_selfloop
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename func_inline_selfloop gold
design -stash gold
read_slang dut.sv --top func_inline_selfloop
hierarchy -check -top func_inline_selfloop
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename func_inline_selfloop gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
sat -verify -prove-asserts -seq 8 -set-init-zero -show-inputs -show-outputs miter

# UHDM-vs-slang miter for elem_field_idx_write.  read_verilog cannot parse a
# struct-member select on a dynamically indexed unpacked array element
# (`tbl[wi].cnt[wk] <= ...`), so the golden reference is the built-in
# read_slang frontend — the same reference used for CVA6 module equivalence.
# async2sync: the DUT's $adff registers have no direct SAT model.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top elem_field_idx_write
flatten; proc; opt; async2sync; techmap; opt
rename elem_field_idx_write gold
design -stash gold

read_slang dut.sv --top elem_field_idx_write
hierarchy -check -top elem_field_idx_write
flatten; proc; opt; async2sync; techmap; opt
rename elem_field_idx_write gate
design -stash gate

design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter

# The VALUE is the gate (read_slang's words): the store port is tagged
# NumPorts-1 = 3, the prefetcher NumPorts = 4, through a 3-bit cast.  Without
# the fix the folded actuals are 1 and 0 and sid_pf_o is 0.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top dut
flatten
proc
opt
sat -verify -set in4 4'b0101 -prove o_store 4'b0011 -prove o_pf 4'b0100 -prove sid_pf_o 3'b100 -prove o_dyn2 4'b0110
sat -verify -set in4 4'b1111 -prove o_dyn2 4'b0000
sat -verify -set in4 4'b0110 -prove o_dyn2 4'b0111

# read_verilog cannot parse a struct parameter at all, so the ordinary
# verilog-vs-uhdm comparison is vacuous here; the miter against read_slang is
# the real gate.  Without the fix the `up` arm folds to a constant whose top bit
# is 0 instead of `s`, and this finds it immediately.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top dut
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename dut gold
design -stash gold
read_slang dut.sv --top dut
hierarchy -check -top dut
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename dut gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 2 -set-init-zero miter

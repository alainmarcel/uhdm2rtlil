# SAT miter, read_uhdm vs read_slang.  This test NEEDS a real miter: with the
# field writes clobbered, `equiv_induct` reports the two netlists equivalent
# anyway (pkt_o[7] is `div_finish ? 0 : src[7]` instead of
# `src[7] | div_finish`, and bit 2 loses `.divide` entirely), while an explicit
# SAT proof against either reference fails in one call.  Gate on this, not on
# test_equivalence.sh.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top comb_field_write_after_switch
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename comb_field_write_after_switch gold
design -stash gold
read_slang dut.sv --top comb_field_write_after_switch
hierarchy -check -top comb_field_write_after_switch
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename comb_field_write_after_switch gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter

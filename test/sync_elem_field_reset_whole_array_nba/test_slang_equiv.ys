# SAT miter, read_uhdm vs read_slang (functional check; read_verilog has no packed
# structs in unpacked arrays).  VACUOUS without the fix -- the conflicting
# drivers are resolved to the constant -- so test_structural.ys is the ratchet.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top sync_elem_field_reset_whole_array_nba
proc; flatten; opt_clean; memory; async2sync
rename sync_elem_field_reset_whole_array_nba gate
design -stash gate
read_slang dut.sv --top sync_elem_field_reset_whole_array_nba
hierarchy -check -top sync_elem_field_reset_whole_array_nba
proc; flatten; opt_clean; memory; async2sync
rename sync_elem_field_reset_whole_array_nba gold
design -stash gold
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter

# SAT miter, read_uhdm vs read_slang, 4 cycles from reset.  Unpatched the
# memory has 4 words instead of 8, the column lands as a bit of the word and
# the reset loop resets one element: the miter finds a counterexample.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top unpacked_2d_dyn_row_mem
proc; flatten; memory; opt_clean; async2sync
rename unpacked_2d_dyn_row_mem gate
design -stash gate
read_slang dut.sv --top unpacked_2d_dyn_row_mem
hierarchy -check -top unpacked_2d_dyn_row_mem
proc; flatten; memory; opt_clean; async2sync
rename unpacked_2d_dyn_row_mem gold
design -stash gold
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter

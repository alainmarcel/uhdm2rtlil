# ReadOnly = 16'b0000_0000_1010_0101: bits 0,2,5,7 are read-only, so next_o
# takes q_i there and d_i elsewhere.  Tab[2] = 8'h3C: bit 5 is 1, bit 0 is 0;
# Tab[0] = 8'h0F: bit 3 is 1, bit 4 is 0.  Every read must be the VALUE, never X.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top dut
flatten; proc; opt -fast
sat -verify -prove next_o 8'b0101_1010 -set d_i 8'hFF -set q_i 8'h00
sat -verify -prove next_o 8'b1010_0101 -set d_i 8'h00 -set q_i 8'hFF
sat -verify -prove ro_o 1'b1 -set sel_i 4'd5
sat -verify -prove ro_o 1'b0 -set sel_i 4'd6
sat -verify -prove ro_o 1'b0 -set sel_i 4'd15
sat -verify -prove tab_c_o 1'b1
# The function-built parameter: same ReadOnly plus bit 12, same Tab.  Tab[0] =
# 8'h0F: bit 3 is 1, bit 4 is 0; Tab[2] = 8'h3C: bit 0 is 0; Tab[3] = 8'hA5: bit 7 is 1.
sat -verify -prove fn_next_o 8'b0101_1010 -set d_i 8'hFF -set q_i 8'h00
sat -verify -prove fn_ro_o 1'b1 -set sel_i 4'd12
sat -verify -prove fn_ro_o 1'b0 -set sel_i 4'd13
sat -verify -prove fn_ro_o 1'b0 -set sel_i 4'd6
sat -verify -prove fn_tab_o 1'b1 -set row_i 2'd0 -set sel_i 4'd3
sat -verify -prove fn_tab_o 1'b0 -set row_i 2'd2 -set sel_i 4'd0
sat -verify -prove fn_tab_o 1'b0 -set row_i 2'd0 -set sel_i 4'd4
sat -verify -prove fn_tab_o 1'b1 -set row_i 2'd3 -set sel_i 4'd7

# An always_latch with an incomplete assignment must become a level-sensitive latch, not a mux or a flop: the enable is `a` and the data is `b`.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top always_tb
proc
opt -full
check -assert
select -assert-count 1 t:$dlatch
select -assert-any t:$dlatch %ci:+[EN] w:a %i
select -assert-any t:$dlatch %ci:+[D] w:b %i

# Bits 9:6 of the concatenation must straddle the operand boundary: at upstream's 10101100/01010011 that is b[1:0]=00 then c[7:6]=01, i.e. 4'b0001.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top top
proc
opt -full
check -assert
sat -verify -prove a 4'b0001 -set b 8'b10101100 -set c 8'b01010011
sat -verify -prove a 4'b1111 -set b 8'b00000011 -set c 8'b11000000

# What the preprocessor substituted into each argument, read back as a value.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top top
flatten
proc
opt -full
check -assert
# po/qo are the string actuals "msg1"/"msg2" as 32-bit values; ro took its default.
sat -verify -prove po 32'd1836279601
sat -verify -prove qo 32'd1836279602
sat -verify -prove ro 32'd103

# The construct under test must be observable: prove the output values.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -auto-top
proc
opt -full
check -assert
sat -verify -prove sum 9'd300 -set a 8'd200 -set b 8'd100
sat -verify -prove sum 9'd0 -set a 8'd0 -set b 8'd0
sat -verify -prove sum 9'd510 -set a 8'd255 -set b 8'd255

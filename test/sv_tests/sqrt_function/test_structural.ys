# `int'($sqrt(9))` must be 3, which is upstream's own asserted value -- read_verilog computes it and read_uhdm returns the argument instead; fixed 2026-11-02, see NOTE.md.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top top
proc
opt -full
check -assert
sat -verify -prove o 32'sd3
sat -verify -prove w 32'sd7 -set x 32'sd7

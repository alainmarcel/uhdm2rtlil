# What the preprocessor substituted into each argument, read back as a value.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top top
flatten
proc
opt -full
check -assert
# po is " msg1" narrowed to 32 bits (the leading space falls off the top); the EMPTY second actual left qo at its default.
sat -verify -prove po 32'd1836279601
sat -verify -prove qo 32'd102
sat -verify -prove ro 32'd103

# At upstream's 32'h70008421 the counts are 7 ones, 25 zeros, 32 for both control bits together and 0 for x/z on a two-state value.  read_verilog computes all five; read_uhdm does NOT implement either function and returns the ARGUMENT instead, which is why this test is a RATCHET -- see NOTE.md.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top top
proc
opt -full
check -assert
sat -verify -prove n_ones  32'sd7  -set val 32'h70008421
sat -verify -prove n_ones2 32'sd7  -set val 32'h70008421
sat -verify -prove n_zeros 32'sd25 -set val 32'h70008421
sat -verify -prove n_both  32'sd32 -set val 32'h70008421
sat -verify -prove n_xz    32'sd0  -set val 32'h70008421

# $bits of the type must be 321, as read_slang measures it -- read_uhdm gives a different width, which is why this is a RATCHET; see NOTE.md.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top test
proc
opt -full
check -assert
sat -verify -prove nbits 32'sd321
sat -verify -prove w 1'b1 -set x 1'b1

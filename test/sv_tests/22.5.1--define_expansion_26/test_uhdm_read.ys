# Test script to read UHDM file in Yosys
plugin -i /home/alain/uhdm2rtlil/build/uhdm2rtlil.so
read_uhdm  slpp_all/surelog.uhdm
#  is sweep bookkeeping (a wire the source assigns); it
# must not reach the synthesised Verilog the equivalence flow compares.
setattr -unset uhdm_src_lhs
# Write RTLIL immediately after reading, before hierarchy
write_rtlil 22.5.1--define_expansion_26_from_uhdm_nohier.il
hierarchy -check -auto-top
stat
proc
opt
stat
write_rtlil 22.5.1--define_expansion_26_from_uhdm.il
# Synthesize to gate-level netlist
synth -auto-top
write_verilog -noexpr 22.5.1--define_expansion_26_from_uhdm_synth.v

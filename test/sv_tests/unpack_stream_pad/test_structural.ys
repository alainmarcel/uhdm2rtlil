# The 96-bit stream must land in the HIGH bits of the 128-bit target, with the low 32 bits zero.  read_slang does that, and so does read_uhdm since 2026-11-02 (it used to put the stream in the LOW bits) -- see NOTE.md.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top top
proc
opt -full
check -assert
sat -verify -prove d 128'hc00000004000000080000000_00000000 -set a 32'd1 -set b 32'd2 -set c 32'd3

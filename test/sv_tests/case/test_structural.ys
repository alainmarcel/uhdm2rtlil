# Every arm, and the default, must be reachable with the selector as a port.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top case_tb
proc
opt -full
check -assert
sat -verify -prove b 4'd12 -set a 4'h0
sat -verify -prove b 4'd4 -set a 4'h3
sat -verify -prove b 4'd8 -set a 4'hf
sat -verify -prove b 4'd0 -set a 4'h7

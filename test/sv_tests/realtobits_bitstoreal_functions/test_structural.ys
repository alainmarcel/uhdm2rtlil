# The round trip must preserve 12.45 (1245 when scaled).  read_slang gives 1245; read_uhdm gives 1200 -- see NOTE.md -- so this is a RATCHET.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top top
proc
opt -full
check -assert
sat -verify -prove o 32'sd1245
sat -verify -prove w 32'sd7 -set x 32'sd7

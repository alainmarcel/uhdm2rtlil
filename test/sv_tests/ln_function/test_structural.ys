# `int'($ln(1))` must be 0, which is upstream's own asserted value -- read_verilog computes it and read_uhdm returns the argument instead, so this is a RATCHET; see NOTE.md.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top top
proc
opt -full
check -assert
sat -verify -prove o 32'sd0
sat -verify -prove w 32'sd7 -set x 32'sd7

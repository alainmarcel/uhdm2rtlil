# Each call's local must start at 0, so both results are the argument plus 1.  read_slang gives 13/13, and so does read_uhdm since 2026-11-02 (it used to give x/x) -- see NOTE.md.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top top
proc
opt -full
check -assert
sat -verify -prove o1 32'sd13 -set x 32'sd12
sat -verify -prove o2 32'sd13 -set x 32'sd12

# read_verilog MIS-SIZES this design -- it measures `bn` (a packed array of
# packed structs inside a struct) as 66 bits instead of 192 and folds every
# output to zero, so the verilog-vs-uhdm comparison is vacuous and the test is
# listed in test/failing_tests.txt for that reason.  read_slang sizes it
# correctly, so IT is the reference here.
read_uhdm slpp_all/surelog.uhdm
hierarchy -top top
prep -top top; async2sync
rename top gold; design -stash g1
read_slang --ignore-assertions dut.sv --top top
hierarchy -top top
prep -top top; async2sync
rename top gate; design -stash g2
design -copy-from g1 -as gold gold
design -copy-from g2 -as gate gate
miter -equiv -flatten -make_assert gold gate m
hierarchy -top m
sat -verify -prove-asserts m

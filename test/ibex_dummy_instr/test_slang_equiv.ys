# UHDM-vs-slang miter for ibex_dummy_instr (read_verilog cannot parse the ibex
# packages).  Adjudicates the co-sim divergence: random stimulus violates
# ibex_alu's `unique case (1'b1)` preconditions, where simulation takes the
# first match but synthesis treats the arms as parallel don't-care.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top ibex_dummy_instr
flatten; proc; delete t:$check t:$assert t:$assume t:$print
opt; async2sync; techmap; opt
rename ibex_dummy_instr gold
design -stash gold

read_slang --ignore-assertions -f project.f -I../ibex/prim -I../ibex/rtl --top ibex_dummy_instr
hierarchy -check -top ibex_dummy_instr
flatten; proc; delete t:$check t:$assert t:$assume t:$print
opt; async2sync; techmap; opt
rename ibex_dummy_instr gate
design -stash gate

design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter

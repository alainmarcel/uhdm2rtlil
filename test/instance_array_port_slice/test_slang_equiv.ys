read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top instance_array_port_slice
flatten; proc; opt; async2sync; setundef -undriven -zero
rename instance_array_port_slice gold
design -stash gold
read_slang dut.sv --top instance_array_port_slice
hierarchy -check -top instance_array_port_slice
flatten; proc; opt; async2sync; setundef -undriven -zero
rename instance_array_port_slice gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter

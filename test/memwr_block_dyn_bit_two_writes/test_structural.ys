# Set bit sp and clear bit fp in the SAME cycle: both must land.
# From act = 0, s_en with sp = 4 and f_en with fp = 0 must give act = 8'h10.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top memwr_block_dyn_bit_two_writes
proc; memory; flatten; opt
sat -seq 2 -set-init-zero -set-at 1 rst 0 -set-at 1 s_en 1 -set-at 1 f_en 1 -set-at 1 sp 4 -set-at 1 fp 0 -prove-skip 1 -prove act 8'h10 -verify

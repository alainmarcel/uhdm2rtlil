{
 "title": "OpenHW CORE-V Wally",
 "url": "https://github.com/openhwgroup/cvw",
 "repos": [
  {
   "url": "https://github.com/openhwgroup/cvw",
   "commit": "bc7012a92273bf7cc5eb487f720be41e9d9e8447",
   "dir": "cvw"
  }
 ],
 "roots": [
  "cvw/src/**/*.sv",
  "cvw/config/rv64gc/*.sv",
  "cvw/config/shared/*.sv"
 ],
 "incdirs": [
  "cvw/config/rv64gc",
  "cvw/config/shared"
 ],
 "defines": [
  "SYNTHESIS"
 ],
 "modules": "auto",
 "exclude": [
  "_tb$",
  "^tb_",
  "^test"
 ],
 "seq": 3,
 "timeout": 300,
 "want": "proven",
 "config_bind": {
  "import": [
   "cvw::*"
  ],
  "includes": [
   "config.vh",
   "parameter-defs.vh"
  ]
 },
 "bind": {
  "values": [
   [
    "^KEY_BITS$",
    61
   ],
   [
    "^SEGMENT_BITS$",
    9
   ],
   [
    "^READ_ONLY$",
    0
   ],
   [
    "^MAX_CSRS$",
    4
   ],
   [
    "^UART_PRESCALE$",
    16
   ]
  ]
 },
 "_note": [
  "",
  "bind.values: parameters WITHOUT a default that a standalone read cannot",
  "supply -- busfsm's READ_ONLY, packetizer's MAX_CSRS, uartPC16550D's",
  "UART_PRESCALE; the values are the ones wallypipelinedsoc / the testbenches use."
 ]
}

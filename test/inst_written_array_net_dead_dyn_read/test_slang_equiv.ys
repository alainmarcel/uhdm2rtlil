read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top inst_written_array_net_dead_dyn_read
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename inst_written_array_net_dead_dyn_read gold
design -stash gold
read_slang dut.sv --top inst_written_array_net_dead_dyn_read
hierarchy -check -top inst_written_array_net_dead_dyn_read
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename inst_written_array_net_dead_dyn_read gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter

# read_verilog cannot parse `parameter type`, so the miter against read_slang
# is this test's formal check (3 steps: write, read, registered read-back).
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top dut
flatten; proc; memory_map; opt -fast; async2sync; setundef -undriven -zero
rename dut gold
design -stash gold
read_slang dut.sv --top dut
hierarchy -check -top dut
flatten; proc; memory_map; opt -fast; async2sync; setundef -undriven -zero
rename dut gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 3 -set-init-zero miter

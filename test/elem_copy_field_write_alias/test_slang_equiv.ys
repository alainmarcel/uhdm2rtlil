read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top elem_copy_field_write_alias
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename elem_copy_field_write_alias gold
design -stash gold
read_slang dut.sv --top elem_copy_field_write_alias
hierarchy -check -top elem_copy_field_write_alias
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename elem_copy_field_write_alias gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 1 -set-init-zero miter

read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top paramod_struct_default_array_fill
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename paramod_struct_default_array_fill gold
design -stash gold
read_slang dut.sv --top paramod_struct_default_array_fill
hierarchy -check -top paramod_struct_default_array_fill
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename paramod_struct_default_array_fill gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 1 -set-init-zero miter

read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top dut
proc
# the register survives the $finish; the $display becomes a $print
select -assert-count 1 t:$dff
select -assert-min 1 t:$print
check -assert
delete t:$print
opt -fast -nodffe -nosdff
dffunmap
sat -verify -seq 2 -set a 4'd5 -prove q 4'd6 -prove-skip 1
sat -verify -seq 2 -set a 4'hF -prove q 4'd0 -prove-skip 1

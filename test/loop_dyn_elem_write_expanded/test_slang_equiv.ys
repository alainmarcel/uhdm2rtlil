# SAT miter, read_uhdm vs read_slang (read_verilog cannot parse the struct).
# Unpatched read_uhdm never writes body outside reset: a counterexample at the first
# write cycle.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top loop_dyn_elem_write_expanded
proc; flatten; opt_clean; memory; async2sync
rename loop_dyn_elem_write_expanded gate
design -stash gate
read_slang dut.sv --top loop_dyn_elem_write_expanded
hierarchy -check -top loop_dyn_elem_write_expanded
proc; flatten; opt_clean; memory; async2sync
rename loop_dyn_elem_write_expanded gold
design -stash gold
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter

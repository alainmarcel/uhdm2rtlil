read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top sync_loop_memwr_multi_memid_mask
flatten; proc; memory; opt -fast; async2sync; setundef -undriven -zero
rename sync_loop_memwr_multi_memid_mask gold
design -stash gold
read_slang dut.sv --top sync_loop_memwr_multi_memid_mask
hierarchy -check -top sync_loop_memwr_multi_memid_mask
flatten; proc; memory; opt -fast; async2sync; setundef -undriven -zero
rename sync_loop_memwr_multi_memid_mask gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter

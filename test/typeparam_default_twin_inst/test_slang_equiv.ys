# read_verilog cannot parse a `parameter type` at all, so the ordinary
# verilog-vs-uhdm comparison is vacuous here and this miter is the real gate.
# Without the fix each slave's decoder is fed bits [1:0] of the address
# instead of [31:0] and `a_o` loses 30 bits, which this finds immediately.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top dut
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename dut gold
design -stash gold
read_slang dut.sv --top dut
hierarchy -check -top dut
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename dut gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 1 -set-init-zero miter

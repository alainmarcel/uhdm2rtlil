# Assert the read_uhdm netlist has NO undriven nets (the fix), then prove it
# equivalent to read_slang.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top func_unused_local_undriven
proc
flatten
opt_clean
check -assert
design -reset
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top func_unused_local_undriven
flatten; proc; opt; memory; async2sync; techmap; opt
rename func_unused_local_undriven gold
design -stash gold
read_slang --ignore-assertions dut.sv --top func_unused_local_undriven
hierarchy -check -top func_unused_local_undriven
flatten; proc; opt; memory; async2sync; techmap; opt
rename func_unused_local_undriven gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 1 -set-init-zero miter

read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top typedef_unpacked_array_elem_select
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename typedef_unpacked_array_elem_select gold
design -stash gold
read_slang dut.sv --top typedef_unpacked_array_elem_select
hierarchy -check -top typedef_unpacked_array_elem_select
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename typedef_unpacked_array_elem_select gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter

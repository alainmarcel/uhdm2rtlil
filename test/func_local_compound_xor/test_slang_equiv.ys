# UHDM-vs-slang miter for func_local_compound_xor.  read_verilog cannot
# parse struct-typed parameters / constant struct-returning functions, so the
# golden reference is the built-in read_slang frontend — the same reference
# used for CVA6 module equivalence.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top func_local_compound_xor
flatten; proc; opt; techmap; opt
rename func_local_compound_xor gold
design -stash gold

read_slang dut.sv --top func_local_compound_xor
hierarchy -check -top func_local_compound_xor
flatten; proc; opt; techmap; opt
rename func_local_compound_xor gate
design -stash gate

design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 2 -set-init-zero miter

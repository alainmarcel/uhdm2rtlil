# Test script to read Verilog file directly in Yosys
read_verilog -sv  dut.sv
# Write RTLIL immediately after reading, before hierarchy
write_rtlil valueless_param_ref_not_a_signal_from_verilog_nohier.il
hierarchy -check -auto-top
stat
proc
opt
stat
write_rtlil valueless_param_ref_not_a_signal_from_verilog.il
# Synthesize to gate-level netlist
synth -auto-top
write_verilog -noexpr valueless_param_ref_not_a_signal_from_verilog_synth.v

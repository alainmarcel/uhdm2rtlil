# Test script to read Verilog file directly in Yosys
read_verilog -sv  ../rp32/riscv/riscv_isa_pkg.sv ../rp32/riscv/riscv_priv_pkg.sv ../rp32/riscv/riscv_isa_i_pkg.sv ../rp32/riscv/riscv_isa_c_pkg.sv ../rp32/core/r5p_gpr_1r1w.sv ../rp32/hamster/r5p_hamster.sv
# Write RTLIL immediately after reading, before hierarchy
write_rtlil rp32_r5p_hamster_from_verilog_nohier.il
hierarchy -check -auto-top
stat
proc
opt
stat
write_rtlil rp32_r5p_hamster_from_verilog.il
# Synthesize to gate-level netlist
synth -auto-top
write_verilog -noexpr rp32_r5p_hamster_from_verilog_synth.v

read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top signed_cmp_negative_const
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename signed_cmp_negative_const gold
design -stash gold
read_slang dut.sv --top signed_cmp_negative_const
hierarchy -check -top signed_cmp_negative_const
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename signed_cmp_negative_const gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter

# SAT miter, read_uhdm vs read_slang.  Unpatched read_uhdm hands the child ONE bit
# for the row actual `we2[w]` of the flat 2-D unpacked array (`{1'b0, we2[w*2]}`
# for its two write enables): a counterexample at the first cycle.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top unpacked_2d_row_actual
proc; flatten; opt_clean; memory; async2sync
rename unpacked_2d_row_actual gate
design -stash gate
read_slang dut.sv --top unpacked_2d_row_actual
hierarchy -check -top unpacked_2d_row_actual
proc; flatten; opt_clean; memory; async2sync
rename unpacked_2d_row_actual gold
design -stash gold
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -set-init-zero miter

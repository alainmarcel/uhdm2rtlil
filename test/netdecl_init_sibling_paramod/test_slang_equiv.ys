read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top netdecl_init_sibling_paramod
flatten; proc; opt; async2sync; setundef -undriven -zero
rename netdecl_init_sibling_paramod gold
design -stash gold
read_slang dut.sv --top netdecl_init_sibling_paramod
hierarchy -check -top netdecl_init_sibling_paramod
flatten; proc; opt; async2sync; setundef -undriven -zero
rename netdecl_init_sibling_paramod gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter

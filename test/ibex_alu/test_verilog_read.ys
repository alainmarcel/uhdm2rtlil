# Test script to read Verilog file directly in Yosys
read_verilog -sv  ../ibex/rtl/ibex_pkg.sv ../ibex/rtl/ibex_alu.sv
# Write RTLIL immediately after reading, before hierarchy
write_rtlil ibex_alu_from_verilog_nohier.il
hierarchy -check -auto-top
stat
proc
opt
stat
write_rtlil ibex_alu_from_verilog.il
# Synthesize to gate-level netlist
synth -auto-top
write_verilog -noexpr ibex_alu_from_verilog_synth.v

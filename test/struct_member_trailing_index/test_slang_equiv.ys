# UHDM-vs-slang miter for struct_member_trailing_index.  read_verilog cannot
# parse a struct-member select on a dynamically indexed unpacked array element
# (`d[pc][row].sat[hist] = ...`), so the golden reference is the built-in
# read_slang frontend — the same reference used for CVA6 module equivalence.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top struct_member_trailing_index
flatten; proc; opt; techmap; opt
rename struct_member_trailing_index gold
design -stash gold

read_slang dut.sv --top struct_member_trailing_index
hierarchy -check -top struct_member_trailing_index
flatten; proc; opt; techmap; opt
rename struct_member_trailing_index gate
design -stash gate

design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter

read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top loopvar_partsel_after_bitsel
flatten; proc; opt; memory; async2sync; techmap; opt
rename loopvar_partsel_after_bitsel gold
design -stash gold
read_slang --ignore-assertions dut.sv --top loopvar_partsel_after_bitsel
hierarchy -check -top loopvar_partsel_after_bitsel
flatten; proc; opt; memory; async2sync; techmap; opt
rename loopvar_partsel_after_bitsel gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts miter

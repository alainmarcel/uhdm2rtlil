# Test script to read Verilog file directly in Yosys
read_verilog -sv  ../rp32/degu/r5p_pkg.sv ../rp32/riscv/riscv_isa_pkg.sv ../rp32/riscv/riscv_priv_pkg.sv ../rp32/riscv/rv32_csr_pkg.sv ../rp32/degu/r5p32_csr_pkg.sv ../rp32/riscv/rv64_csr_pkg.sv ../rp32/degu/r5p64_csr_pkg.sv ../rp32/riscv/riscv_isa_i_pkg.sv ../rp32/degu/r5p_csr.sv
# Write RTLIL immediately after reading, before hierarchy
write_rtlil rp32_r5p_csr_from_verilog_nohier.il
hierarchy -check -auto-top
stat
proc
opt
stat
write_rtlil rp32_r5p_csr_from_verilog.il
# Synthesize to gate-level netlist
synth -auto-top
write_verilog -noexpr rp32_r5p_csr_from_verilog_synth.v

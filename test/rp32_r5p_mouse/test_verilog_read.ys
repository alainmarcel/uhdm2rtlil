# Test script to read Verilog file directly in Yosys
read_verilog -sv  ../rp32/mouse/r5p_mouse.sv
# Write RTLIL immediately after reading, before hierarchy
write_rtlil rp32_r5p_mouse_from_verilog_nohier.il
hierarchy -check -auto-top
stat
proc
opt
stat
write_rtlil rp32_r5p_mouse_from_verilog.il
# Synthesize to gate-level netlist
synth -auto-top
write_verilog -noexpr rp32_r5p_mouse_from_verilog_synth.v

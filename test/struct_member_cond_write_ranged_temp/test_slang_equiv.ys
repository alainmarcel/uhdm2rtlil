read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top struct_member_cond_write_ranged_temp
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename struct_member_cond_write_ranged_temp gold
design -stash gold
read_slang dut.sv --top struct_member_cond_write_ranged_temp
hierarchy -check -top struct_member_cond_write_ranged_temp
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename struct_member_cond_write_ranged_temp gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter

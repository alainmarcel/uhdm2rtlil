# SAT miter, read_uhdm vs read_slang (read_verilog cannot parse the interfaces).
# Kept as the functional check; the ratchet is test_structural.ys.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top gen_scope_iface_member_clk_actual
proc; flatten; opt_clean; memory; async2sync
rename gen_scope_iface_member_clk_actual gate
design -stash gate
read_slang dut.sv --top gen_scope_iface_member_clk_actual
hierarchy -check -top gen_scope_iface_member_clk_actual
proc; flatten; opt_clean; memory; async2sync
rename gen_scope_iface_member_clk_actual gold
design -stash gold
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter

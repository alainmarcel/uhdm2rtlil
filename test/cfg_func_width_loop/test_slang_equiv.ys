# UHDM-vs-slang miter for cfg_func_width_loop.  read_verilog cannot
# parse struct-typed parameters / constant struct-returning functions, so the
# golden reference is the built-in read_slang frontend — the same reference
# used for CVA6 module equivalence.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top cfg_func_width_loop
flatten; proc; opt; techmap; opt
rename cfg_func_width_loop gold
design -stash gold

read_slang dut.sv --top cfg_func_width_loop
hierarchy -check -top cfg_func_width_loop
flatten; proc; opt; techmap; opt
rename cfg_func_width_loop gate
design -stash gate

design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 2 -set-init-zero miter

# The shift amounts here are self-determined; without the fix the context
# 31-bit default and bit 39 vanishes: state_out[39] has no XOR term.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top dut
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename dut gold
design -stash gold
read_slang dut.sv --top dut
hierarchy -check -top dut
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename dut gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 1 -set-init-zero miter

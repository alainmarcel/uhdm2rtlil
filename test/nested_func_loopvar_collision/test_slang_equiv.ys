read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top nested_func_loopvar_collision
flatten; proc; opt; memory; async2sync; techmap; opt
rename nested_func_loopvar_collision gold
design -stash gold
read_slang --ignore-assertions dut.sv --top nested_func_loopvar_collision
hierarchy -check -top nested_func_loopvar_collision
flatten; proc; opt; memory; async2sync; techmap; opt
rename nested_func_loopvar_collision gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 1 -set-init-zero miter

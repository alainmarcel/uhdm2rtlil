read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top func_concat_formal_width_probe
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename func_concat_formal_width_probe gold
design -stash gold
read_slang dut.sv --top func_concat_formal_width_probe
hierarchy -check -top func_concat_formal_width_probe
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename func_concat_formal_width_probe gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero -set-def-inputs -show-all miter

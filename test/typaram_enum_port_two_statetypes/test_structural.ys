# The two enum-bound instances must be distinct paramods with 2- and 4-bit
# TYPE ports, and the walker must leave IDLE (9) when told to.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top dut
select -assert-count 1 t:*typaram_1_1_1_2_2_2
select -assert-count 1 t:*typaram_1_1_1_4_4_4
flatten; proc; opt -fast
sat -verify -seq 2 -set-init-zero -set-at 1 reset 1 -set-at 2 reset 0 -set-at 2 wnext_i 4'd3 -prove-skip 1 -prove wstate_o 4'd9
sat -verify -seq 3 -set-init-zero -set-at 1 reset 1 -set-at 2 reset 0 -set-at 2 wnext_i 4'd3 -set-at 3 reset 0 -set-at 3 wnext_i 4'd3 -prove-skip 2 -prove wstate_o 4'd3

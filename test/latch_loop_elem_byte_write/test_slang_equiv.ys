# UHDM-vs-slang miter for latch_loop_elem_byte_write.  read_verilog rejects a
# module-level loop variable inside an always_latch ("No latch inferred for
# signal k from always_latch process"), so the reference is read_slang, which
# infers one $dlatch per bit here.  Combinational miter over the latch
# netlists after async2sync (the latch becomes a clocked hold), proven from
# an all-zero initial state over 4 steps.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top dut
flatten; proc; opt -fast; async2sync; opt_clean
rename dut gold
design -stash gold

read_slang dut.sv --top dut
hierarchy -check -top dut
flatten; proc; opt -fast; async2sync; opt_clean
rename dut gate
design -stash gate

design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero -show-inputs miter

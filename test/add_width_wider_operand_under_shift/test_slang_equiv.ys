read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top add_width_wider_operand_under_shift
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename add_width_wider_operand_under_shift gold
design -stash gold
read_slang dut.sv --top add_width_wider_operand_under_shift
hierarchy -check -top add_width_wider_operand_under_shift
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename add_width_wider_operand_under_shift gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter

read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top pkg_param_elem_select
flatten; proc; opt; memory; async2sync; techmap; opt
rename pkg_param_elem_select gold
design -stash gold
read_slang --ignore-assertions dut.sv --top pkg_param_elem_select
hierarchy -check -top pkg_param_elem_select
flatten; proc; opt; memory; async2sync; techmap; opt
rename pkg_param_elem_select gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 1 -set-init-zero miter

# SAT miter, read_uhdm vs read_slang.  Without the fix `y` reads the element
# wire's end-of-block (shifted) value and the miter finds a model.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top dyn_elem_read_inflight
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename dyn_elem_read_inflight gold
design -stash gold
read_slang dut.sv --top dyn_elem_read_inflight
hierarchy -check -top dyn_elem_read_inflight
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename dyn_elem_read_inflight gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 2 -set-init-zero miter

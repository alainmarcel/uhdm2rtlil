# UHDM-vs-slang miter (read_verilog rejects the unpacked-dim localparam).
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top param_table_elem_partsel
flatten; proc; opt; techmap; opt
rename param_table_elem_partsel gold
design -stash gold
read_slang dut.sv --top param_table_elem_partsel
hierarchy -check -top param_table_elem_partsel
flatten; proc; opt; techmap; opt
rename param_table_elem_partsel gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter

# read_verilog cannot be the gold here: it has no member access on an unpacked
# array element at all -- it implicitly declares `\complexOpInfo[0].mulSubInfo'
# as a fresh 1-bit wire (12 such warnings) and synthesises no logic, so the
# ordinary verilog-vs-uhdm comparison is vacuous.  read_slang resolves the
# union members correctly, so this miter is the only real gate on this test.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top array_elem_union_member_read
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename array_elem_union_member_read gold
design -stash gold
read_slang dut.sv --top array_elem_union_member_read
hierarchy -check -top array_elem_union_member_read
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename array_elem_union_member_read gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter

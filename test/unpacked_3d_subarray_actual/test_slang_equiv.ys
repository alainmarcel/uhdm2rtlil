# SAT miter, read_uhdm vs read_slang.  Unpatched read_uhdm imports the two-index
# sub-array actual `we3[i][w]` of the 3-D unpacked array as ONE bit at the
# flat index of the first two dims, so the child sees `{1'b0, bit}` for its two
# write enables: a counterexample at the first cycle.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top unpacked_3d_subarray_actual
proc; flatten; opt_clean; memory; async2sync
rename unpacked_3d_subarray_actual gate
design -stash gate
read_slang dut.sv --top unpacked_3d_subarray_actual
hierarchy -check -top unpacked_3d_subarray_actual
proc; flatten; opt_clean; memory; async2sync
rename unpacked_3d_subarray_actual gold
design -stash gold
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -set-init-zero miter

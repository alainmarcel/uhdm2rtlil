# SAT miter, read_uhdm vs read_slang (read_verilog cannot parse the struct).
# Unpatched read_uhdm never resets body: a counterexample at the first
# reset cycle.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top dyn_elem_write_after_bit_reset
proc; flatten; opt_clean; memory; async2sync
rename dyn_elem_write_after_bit_reset gate
design -stash gate
read_slang dut.sv --top dyn_elem_write_after_bit_reset
hierarchy -check -top dyn_elem_write_after_bit_reset
proc; flatten; opt_clean; memory; async2sync
rename dyn_elem_write_after_bit_reset gold
design -stash gold
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter

read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top genscope_unpacked_array_per_elem_ff
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename genscope_unpacked_array_per_elem_ff gold
design -stash gold
read_slang dut.sv --top genscope_unpacked_array_per_elem_ff
hierarchy -check -top genscope_unpacked_array_per_elem_ff
flatten; proc; opt -fast; async2sync; setundef -undriven -zero
rename genscope_unpacked_array_per_elem_ff gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter

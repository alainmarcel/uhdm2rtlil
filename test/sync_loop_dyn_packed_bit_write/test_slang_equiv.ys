# SAT miter, read_uhdm vs read_slang: FAILS without the fix.
read_uhdm slpp_all/surelog.uhdm
hierarchy -check -top sync_loop_dyn_packed_bit_write
proc; flatten; opt_clean; memory; async2sync
rename sync_loop_dyn_packed_bit_write gate
design -stash gate
read_slang dut.sv --top sync_loop_dyn_packed_bit_write
hierarchy -check -top sync_loop_dyn_packed_bit_write
proc; flatten; opt_clean; memory; async2sync
rename sync_loop_dyn_packed_bit_write gold
design -stash gold
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
sat -verify -prove-asserts -seq 4 -set-init-zero miter
